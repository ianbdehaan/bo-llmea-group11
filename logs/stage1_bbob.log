# Description 
LatinHypercubeMaternEI is a Bayesian Optimization algorithm tailored for unimodal functions like Rosenbrock. It uses Latin Hypercube Sampling (LHS) for initial design, Gaussian Process (GP) with anisotropic Matern kernel as the surrogate model, Expected Improvement (EI) as the acquisition function, and Sobol-sequence based candidates combined with L-BFGS-B for acquisition optimization. The algorithm balances exploration via diverse candidates and exploitation via gradient-based refinement.

# Justification 
1. **Initial Design**: Latin Hypercube ensures even coverage in high-dimensional space, critical for the Rosenbrock function's valley structure.  
2. **Surrogate Model**: Matern kernel (nu=2.5) with ARD adapts to the problem's smoothness and varying feature importance, while simple hyperparameter optimization keeps computation low.  
3. **Acquisition Function**: EI effectively balances exploration and exploitation for unimodal problems without requiring manual exploration parameters.  
4. **Acquisition Optimization**: Sobol candidates ensure diverse starting points, while L-BFGS-B efficiently converges to local optima. Limits on iterations and restarts maintain efficiency.  
5. **Reproducibility**: All random generators are seeded, ensuring deterministic behavior across runs.

# Code 
```python
from collections.abc import Callable
from scipy.stats import qmc, norm
from scipy.optimize import minimize
from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import Matern
import numpy as np

class LatinHypercubeMaternEI:
    def __init__(self, budget: int, dim: int):
        self.budget = budget
        self.dim = dim
        self.bounds = np.array([[-5.0] * dim, [5.0] * dim])
        self.X: np.ndarray = None
        self.y: np.ndarray = None
        self.n_evals = 0
        self.n_init = max(5 * dim, 20)  # Initial samples
        self.rng = np.random.default_rng(np.random.randint(2**31 - 1))

    def _sample_points(self, n_points):
        # Latin Hypercube Sampling
        sampler = qmc.LatinHypercube(d=self.dim, seed=int(self.rng.integers(2**31 - 1)))
        samples = qmc.scale(sampler.random(n_points), self.bounds[0], self.bounds[1])
        return samples

    def _fit_model(self, X, y):
        # Gaussian Process with ARD Matern kernel
        kernel = 1.0 * Matern(nu=2.5, length_scale=np.ones(self.dim), length_scale_bounds=(1e-2, 1e2))
        gp = GaussianProcessRegressor(
            kernel=kernel,
            alpha=1e-6,
            optimizer='fmin_l_bfgs_b',
            n_restarts_optimizer=1,  # Minimal hyperparameter restarts for efficiency
            random_state=int(self.rng.integers(2**31 - 1)),
        )
        gp.fit(X, y)
        return gp

    def _acquisition_function(self, X):
        # Expected Improvement (EI)
        mu, sigma = self.gp.predict(X, return_std=True)
        sigma = np.clip(sigma, 1e-9, np.inf)
        f_best = np.min(self.y)
        imp = mu - f_best
        Z = imp / sigma
        ei = imp * norm.cdf(Z) + sigma * norm.pdf(Z)
        ei[sigma == 0] = 0.0  # Avoid evaluating already sampled points
        return ei

    def _select_next_points(self, batch_size):
        # Generate Sobol candidates and optimize acquisition function
        n_candidates = max(20, 5 * self.dim)
        sobol_sampler = qmc.Sobol(d=self.dim, scramble=True, seed=int(self.rng.integers(2**31 - 1)))
        X_candidates = qmc.scale(sobol_sampler.random(n_candidates), self.bounds[0], self.bounds[1])
        
        # Evaluate EI on candidates
        ei_values = self._acquisition_function(X_candidates)
        
        # Select top 2 candidates as initial guesses
        top_indices = np.argsort(ei_values, axis=0)[-2:][::-1]
        X_init = X_candidates[top_indices]
        
        best_x = None
        best_ei = -np.inf
        for x0 in X_init:
            # Optimize acquisition with L-BFGS-B
            res = minimize(
                lambda x: -self._acquisition_function(x.reshape(1, -1))[0],
                x0=x0,
                bounds=[(l, u) for l, u in zip(self.bounds[0], self.bounds[1])],
                method='L-BFGS-B',
                options={'maxiter': 30, 'ftol': 1e-6, 'gtol': 1e-6}
            )
            if res.success:
                current_ei = -res.fun
                if current_ei > best_ei:
                    best_ei = current_ei
                    best_x = res.x
        
        # Fallback if no valid points
        if best_x is None:
            best_x = X_candidates[np.argmin(ei_values)]
        
        return best_x.reshape(1, -1)

    def _evaluate_points(self, func, X):
        # Evaluate func for each point in X
        y = np.array([func(x) for x in X]).reshape(-1, 1)
        return y

    def _update_eval_points(self, new_X, new_y):
        # Append new data
        if self.X is None:
            self.X = new_X
            self.y = new_y
        else:
            self.X = np.vstack((self.X, new_X))
            self.y = np.vstack((self.y, new_y))

    def __call__(self, func: Callable[[np.ndarray], np.float64]) -> tuple[np.float64, np.ndarray]:
        # Initialization
        self.X = self._sample_points(self.n_init)
        self.y = self._evaluate_points(func, self.X)
        self.n_evals += self.n_init
        self.gp = self._fit_model(self.X, self.y)
        best_idx = np.argmin(self.y)
        best_y, best_x = self.y[best_idx], self.X[best_idx]

        while self.n_evals < self.budget:
            # Acquisition optimization
            next_point = self._select_next_points(batch_size=1)
            next_y = self._evaluate_points(func, next_point)
            self._update_eval_points(next_point, next_y)
            self.gp = self._fit_model(self.X, self.y)
            best_idx = np.argmin(self.y)
            best_y, best_x = self.y[best_idx], self.X[best_idx]

        return best_y.item(), best_x
