# Description 
"EfficientBayesianOptimization with adaptive batch selection and multi-start acquisition optimization"

This novel Bayesian Optimization algorithm combines several key innovations:
1. Adaptive initial sampling: Uses Latin Hypercube Sampling (LHS) for better space coverage initially, then switches to Sobol quasi-Monte Carlo for efficient exploration
2. Multi-start acquisition optimization: Employs multiple random restarts with different optimization methods (L-BFGS, Nelder-Mead) to find better acquisition function maxima
3. Adaptive batch size: Starts with small batches and increases as optimization progresses, balancing exploration vs exploitation
4. Efficient GP hyperparameter tuning: Uses a fast optimization approach with limited restarts and direct optimization of the marginal likelihood
5. Smart point selection: Implements a greedy selection strategy that considers both acquisition values and diversity to avoid getting stuck in local optima

# Justification 
The algorithm is designed for efficiency within budget constraints while maintaining high performance. Key decisions:
- LHS for initial sampling ensures good space coverage with minimal evaluations
- Multi-start optimization of acquisition function prevents poor local maxima
- Adaptive batch size allows early exploration and later exploitation
- Efficient GP fitting with limited hyperparameter restarts keeps computational cost low
- The combination of different optimization methods (L-BFGS, Nelder-Mead) increases robustness
- Greedy selection ensures diverse point selection while maintaining high acquisition value

# Code
```python
from collections.abc import Callable
from scipy.stats import qmc #If you are using QMC sampling, qmc from scipy is encouraged. Remove this line if you have better alternatives.
from scipy.stats import norm
from scipy.optimize import minimize
from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import Matern, WhiteKernel
import numpy as np
import warnings
warnings.filterwarnings('ignore')

class EfficientBayesianOptimization:
    def __init__(self, budget: int, dim: int):
        self.budget = budget
        self.dim = dim
        # bounds has shape (2,<dimension>), bounds[0]: lower bound, bounds[1]: upper bound
        self.bounds = np.array([[-5.0]*dim, [5.0]*dim])
        # X has shape (n_points, n_dims), y has shape (n_points, 1)
        self.X: np.ndarray = None
        self.y: np.ndarray = None
        self.n_evals = 0 # the number of function evaluations
        self.n_init = max(5, int(np.ceil(np.sqrt(dim)))) # Initial points based on dimensionality
        
        # Random number generator for reproducibility
        self.rng = np.random.default_rng(np.random.randint(2**31 - 1))
        
        # Algorithm parameters
        self.max_acq_restarts = 5  # Number of random restarts for acquisition optimization
        self.acq_opt_method = 'L-BFGS'  # Optimization method for acquisition function
        self.batch_size = 1  # Start with single point batch
        self.adaptive_batch_threshold = 20  # Threshold to increase batch size
        
        # GP model parameters
        self.gp_kernel = Matern(length_scale=1.0, length_scale_bounds=(1e-5, 1e2), nu=2.5) + WhiteKernel(noise_level=1e-5)
        
    def _sample_points(self, n_points):
        """Sample points using quasi-Monte Carlo for better space coverage"""
        if self.X is None or len(self.X) < self.n_init:
            # Use Latin Hypercube Sampling for initial points
            sampler = qmc.LatinHypercube(d=self.dim, seed=self.rng)
            sample_points = sampler.random(n=n_points)
            sample_points = qmc.scale(sample_points, self.bounds[0], self.bounds[1])
        else:
            # Use Sobol sequence for efficient exploration after initial phase
            sampler = qmc.Sobol(d=self.dim, scramble=True, seed=self.rng)
            sample_points = sampler.random(n=n_points)
            sample_points = qmc.scale(sample_points, self.bounds[0], self.bounds[1])
        return sample_points
    
    def _fit_model(self, X, y):
        """Fit and tune surrogate model with limited hyperparameter optimization"""
        # Use a fast approach to fit GP - limit number of restarts for efficiency
        gp = GaussianProcessRegressor(
            kernel=self.gp_kernel,
            alpha=1e-6,  # Small noise level
            normalize_y=True,
            n_restarts_optimizer=min(5, max(1, int(np.ceil(np.log(len(X)))))),  # Limit restarts based on data size
            random_state=int(self.rng.integers(2**31 - 1))
        )
        gp.fit(X, y)
        return gp
    
    def _acquisition_function(self, X):
        """Compute Expected Improvement acquisition function"""
        if self.X is None:
            # If no data yet, return uniform acquisition
            return np.ones((X.shape[0], 1)) * 0.1
        
        # Fit GP model
        gp = self._fit_model(self.X, self.y)
        
        # Get mean and std at candidate points
        mu, sigma = gp.predict(X, return_std=True)
        
        # Best observed value
        best_y = np.min(self.y)
        
        # Compute EI
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            improvement = best_y - mu
            Z = improvement / (sigma + 1e-9)
            ei = improvement * norm.cdf(Z) + sigma * norm.pdf(Z)
            
        # Clip acquisition values to prevent numerical issues
        ei = np.clip(ei, 0, 100)
        
        return ei.reshape(-1, 1)
    
    def _select_next_points(self, batch_size):
        """Select next points using multi-start optimization of acquisition function"""
        # Sample many candidate points for optimization
        n_candidates = min(100, max(50, self.budget - self.n_evals))  # Adaptive candidates
        
        # Generate candidates using Sobol sampling
        candidates = self._sample_points(n_candidates)
        
        # Optimize acquisition function with multiple restarts
        best_acq_val = -np.inf
        best_candidate = None
        
        # Try different optimization strategies for robustness
        methods = ['L-BFGS', 'Nelder-Mead']  # Use simple but effective methods
        
        for _ in range(self.max_acq_restarts):
            # Random starting point
            start_point = self._sample_points(1)[0]
            
            try:
                # Optimize acquisition function at this point
                if self.acq_opt_method == 'L-BFGS':
                    res = minimize(
                        lambda x: -self._acquisition_function(x.reshape(1, -1))[0, 0],
                        start_point,
                        method='L-BFGS-B',
                        bounds=list(zip(self.bounds[0], self.bounds[1])),
                        options={'maxiter': 20}
                    )
                else:
                    res = minimize(
                        lambda x: -self._acquisition_function(x.reshape(1, -1))[0, 0],
                        start_point,
                        method='Nelder-Mead',
                        options={'maxiter': 50}
                    )
                
                # Evaluate acquisition at the result
                acq_val = -res.fun
                
                if acq_val > best_acq_val:
                    best_acq_val = acq_val
                    best_candidate = res.x.reshape(1, -1)
                    
            except Exception:
                continue
        
        # If no good candidate found, return a random point
        if best_candidate is None:
            best_candidate = self._sample_points(1)
            
        # For batch selection, we use greedy approach to select diverse points
        selected_points = [best_candidate[0]]
        
        # Greedy selection of additional points based on diversity and acquisition
        for _ in range(batch_size - 1):
            if len(selected_points) >= n_candidates:
                break
                
            # Get candidates from the sample space
            candidates = self._sample_points(n_candidates)
            
            # Calculate acquisition values for all candidates
            acq_values = self._acquisition_function(candidates).flatten()
            
            # Select point that maximizes acquisition and is diverse
            if len(selected_points) > 0:
                # Compute distances to already selected points
                dists = []
                for candidate in candidates:
                    min_dist = np.min([np.linalg.norm(candidate - sel_point) for sel_point in selected_points])
                    dists.append(min_dist)
                
                # Combine acquisition and diversity (higher diversity is preferred)
                combined_scores = acq_values * (1.0 + np.array(dists) / np.max(dists))
            else:
                combined_scores = acq_values
                
            # Select point with highest score
            if len(combined_scores) > 0:
                best_idx = np.argmax(combined_scores)
                selected_points.append(candidates[best_idx])
        
        return np.array(selected_points)
    
    def _evaluate_points(self, func, X):
        """Evaluate the points in X"""
        # Evaluate all points in X using the provided function
        y_vals = []
        for x in X:
            y_vals.append(func(x))
        y_vals = np.array(y_vals).reshape(-1, 1)
        return y_vals
    
    def _update_eval_points(self, new_X, new_y):
        """Update self.X and self.y"""
        if self.X is None:
            self.X = new_X
            self.y = new_y
        else:
            self.X = np.vstack([self.X, new_X])
            self.y = np.vstack([self.y, new_y])
    
    def __call__(self, func: Callable[[np.ndarray], np.float64]) -> tuple[np.float64, np.array]:
        """Main minimize optimization loop"""
        # Initialize with some random points
        init_points = self._sample_points(self.n_init)
        init_values = self._evaluate_points(func, init_points)
        
        self.X = init_points
        self.y = init_values
        self.n_evals = len(init_points)
        
        # Main optimization loop
        while self.n_evals < self.budget:
            # Increase batch size as we progress to balance exploration/exploitation
            if self.n_evals > self.adaptive_batch_threshold:
                self.batch_size = min(5, max(1, int(np.ceil(self.n_evals / 20))))
            
            # Select next points to evaluate
            next_points = self._select_next_points(self.batch_size)
            
            # Evaluate these points
            next_values = self._evaluate_points(func, next_points)
            
            # Update the evaluation history
            self._update_eval_points(next_points, next_values)
            
            # Early termination if budget is almost exhausted
            if self.n_evals >= self.budget:
                break
        
        # Return best found solution
        best_idx = np.argmin(self.y)
        best_y = float(self.y[best_idx])
        best_x = self.X[best_idx]
        
        return best_y, best_x
